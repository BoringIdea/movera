{
  "name": "@movera/sdk",
  "version": "0.0.20-beta",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./aptos": {
      "types": "./aptos.d.ts",
      "import": "./dist/aptos/index.js",
      "default": "./dist/aptos/index.js"
    },
    "./aptos/blob-utils": {
      "types": "./dist/aptos/blob-utils.d.ts",
      "import": "./dist/aptos/blob-utils.js",
      "default": "./dist/aptos/blob-utils.js"
    },
    "./sui": {
      "types": "./sui.d.ts",
      "import": "./dist/sui/index.js",
      "default": "./dist/sui/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "test",
    "README.md"
  ],
  "author": "Luke Ma <lukema95@gmail.com>",
  "license": "Business Source License 1.1",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@aptos-labs/ts-sdk": "^1.39.0",
    "@mysten/bcs": "^1.6.1",
    "@mysten/sui": "^1.30.1",
    "@mysten/seal": "^0.9.4",
    "@mysten/walrus": "^0.8.4",
    "@noble/hashes": "^1.7.0",
    "@shelby-protocol/sdk": "latest",
    "@thalalabs/surf": "^1.9.6",
    "dotenv": "^16.5.0",
    "got": "^11.8.6"
  }
}
